---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'C.D. Nadamás Santa Rosa | Club de Natación en Costa Teguise, Lanzarote',
  description = 'Club de natación C.D. Nadamás Santa Rosa en Costa Teguise, Lanzarote. Campeones de Canarias y de España. Escuela de natación, competición, máster y aguas abiertas.',
} = Astro.props;
---

<!doctype html>
<html lang="es" class="light" style="color-scheme: light;">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />
    <meta name="theme-color" content="#00226D" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Gates the scroll-reveal animations: without JS nothing is hidden.
         Runs before first paint so revealed content never flashes. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://clubnadamas.es/" />

    <!-- Google Tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-69M5QJFF1F"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-69M5QJFF1F');
    </script>

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="C.D. Nadamás Santa Rosa" />

    <!-- Fonts: Montserrat (Headings) & Roboto (Body) & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Roboto:wght@400;500;700&family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen flex flex-col bg-white text-navy-900 selection:bg-brand-red selection:text-white">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Scroll Reveal Observer Script -->
    <script>
      const observerCallback: IntersectionObserverCallback = (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');

          // Cards inside a horizontal carousel sit outside the viewport once the
          // row is scrolled sideways, so they never intersect on their own.
          // Reveal them together with their row.
          if (entry.target.classList.contains('carousel-row')) {
            entry.target
              .querySelectorAll('[class*="reveal-delay-"]')
              .forEach((card) => card.classList.add('is-visible'));
          }

          observer.unobserve(entry.target);
        });
      };

      const observerOptions: IntersectionObserverInit = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px',
      };

      function initReveal() {
        // Match every delay step, so adding a new one never leaves cards stuck
        // at opacity 0 because the selector list went stale.
        const targets = document.querySelectorAll('.reveal, [class*="reveal-delay-"], .carousel-row');

        if (!('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
          return;
        }

        const observer = new IntersectionObserver(observerCallback, observerOptions);
        targets.forEach((el) => observer.observe(el));
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initReveal);
      } else {
        initReveal();
      }
    </script>
  </body>
</html>
