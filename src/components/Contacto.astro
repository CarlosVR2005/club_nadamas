---
/* Contacto: Contact info, map and opening hours */
---

<section id="contacto" class="relative section-padding bg-white scroll-mt-24">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span
        class="inline-block px-4 py-1.5 rounded-full bg-[#ED1C24]/10 text-[#ED1C24] text-xs font-bold tracking-widest uppercase mb-4 font-heading"
      >
        Contacto y Ubicación
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-black text-[#00226D] mb-4 font-heading"
      >
        Ven a <span class="text-[#ED1C24]">conocernos</span>
      </h2>
      <p class="max-w-2xl mx-auto text-slate-600 text-base sm:text-lg">
        Estamos en el C.D. Santa Rosa, en el corazón de Costa Teguise,
        Lanzarote.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-start">
      <!-- Contact Cards -->
      <div class="space-y-6">
        <!-- Address -->
        <div
          class="card-modern p-6 flex items-start gap-4 border-slate-200 hover:border-[#ED1C24]/40 reveal-delay-1"
        >
          <div
            class="shrink-0 w-12 h-12 rounded-xl bg-[#00226D] text-white flex items-center justify-center shadow-md"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="text-[#00226D] font-bold text-lg mb-1 font-heading">
              Dirección
            </h3>
            <p class="text-slate-600 text-sm leading-relaxed">
              Club Deportivo Santa Rosa<br />
              Av. de los Volcanes, 4, 35508 Costa Teguise, Lanzarote<br />
              Las Palmas, Islas Canarias
            </p>
          </div>
        </div>

        <!-- Phone Card -->
        <div
          class="card-modern p-6 flex items-start gap-4 border-slate-200 hover:border-[#ED1C24]/40 reveal-delay-2"
        >
          <div
            class="shrink-0 w-12 h-12 rounded-xl bg-[#ED1C24] text-white flex items-center justify-center shadow-md"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="text-[#00226D] font-bold text-lg mb-1 font-heading">
              Teléfono Oficial
            </h3>
            <div>
              <a
                href="tel:928346038"
                class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#ED1C24]/10 hover:bg-[#ED1C24]/20 text-[#ED1C24] font-extrabold text-base transition-colors border border-[#ED1C24]/30"
              >
                <svg
                  class="w-4 h-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
                  ></path>
                </svg>
                928 346 038
              </a>
            </div>
          </div>
        </div>

        <!-- Email -->
        <div
          class="card-modern p-6 flex items-start gap-4 border-slate-200 hover:border-[#ED1C24]/40 reveal-delay-3"
        >
          <div
            class="shrink-0 w-12 h-12 rounded-xl bg-[#00226D] text-white flex items-center justify-center shadow-md"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
              ></path>
            </svg>
          </div>
          <div>
            <h3 class="text-[#00226D] font-bold text-lg mb-1 font-heading">
              Email
            </h3>
            <a
              href="mailto:clubnadamaslasmarinas@hotmail.es"
              class="text-[#ED1C24] hover:underline text-sm font-semibold transition-colors"
            >
              clubnadamaslasmarinas@hotmail.es
            </a>
          </div>
        </div>

        <!-- Opening hours -->
        <div
          class="card-modern p-6 flex items-start gap-4 border-slate-200 hover:border-[#ED1C24]/40 reveal-delay-3"
        >
          <div
            class="shrink-0 w-12 h-12 rounded-xl bg-[#00226D] text-white flex items-center justify-center shadow-md"
          >
            <svg
              class="w-6 h-6"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <div>
            <h3 class="text-[#00226D] font-bold text-lg mb-1 font-heading">
              Horario de Atención Presencial
            </h3>
            <p
              class="text-slate-600 text-sm leading-relaxed mb-2 font-semibold"
            >
              Recepción del C.D. Santa Rosa
            </p>
            <div
              class="inline-block px-3 py-1 rounded-lg bg-slate-100 text-[#00226D] font-bold text-sm border border-slate-200"
            >
              Lunes a Viernes: 16:00 – 19:30 h
            </div>
          </div>
        </div>
      </div>

      <!-- Google Maps Embed -->
      <div
        class="card-modern overflow-hidden h-full min-h-[420px] border-slate-200 reveal-delay-2"
      >
        <iframe
          src="https://maps.google.com/maps?q=Club+Deportivo+Santa+Rosa+Costa+Teguise+Lanzarote&t=&z=15&ie=UTF8&iwloc=&output=embed"
          class="w-full h-full min-h-[420px] border-0"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación del C.D. Santa Rosa en Costa Teguise, Lanzarote"
        ></iframe>
      </div>
    </div>
  </div>
</section>
