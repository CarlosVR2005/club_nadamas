---
import { entrenadores } from '../data/entrenadores';
---

<section id="entrenadores" class="relative section-padding bg-navy-50 scroll-mt-24">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 rounded-full bg-brand-red/10 text-brand-red text-xs font-bold tracking-widest uppercase mb-4 font-heading border border-brand-red/20">
        Equipo Técnico
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-navy-900 mb-4 font-heading">
        Nuestros <span class="text-brand-red">Entrenadores</span>
      </h2>
      <p class="max-w-2xl mx-auto text-slate-600 text-base sm:text-lg">
        Técnicos titulados de alto nivel comprometidos con la enseñanza, la superación personal y la formación de campeones del C.N. Nadamás Las Marinas.
      </p>
    </div>

    <!-- Coaches Grid -->
    <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-6 -mx-4 px-4 carousel-row sm:grid sm:grid-cols-2 sm:gap-6 sm:overflow-visible sm:snap-none sm:mx-0 sm:px-0 sm:pb-0 lg:grid-cols-4 lg:gap-8 mb-12">
      {entrenadores.map((coach, idx) => (
        <div class={`card-modern overflow-hidden border-slate-200 hover:border-brand-red/50 flex flex-col justify-between group shrink-0 w-[78%] snap-start sm:w-auto reveal-delay-${idx + 1}`}>
          <div>
            <!-- Coach Photo -->
            <div class="relative h-64 overflow-hidden bg-navy-950">
              <img
                src={coach.imagen}
                alt={coach.nombre}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/90 via-transparent to-transparent"></div>
              <div class="absolute bottom-3 left-4 right-4">
                <span class="inline-block px-2.5 py-1 rounded-full bg-brand-red text-white text-[10px] font-extrabold uppercase tracking-wider shadow-md">
                  {coach.experiencia}
                </span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6 bg-white">
              <span class="text-xs font-bold text-brand-red uppercase tracking-wider block mb-1">
                {coach.especialidad}
              </span>
              <h3 class="text-xl font-bold text-navy-900 font-heading group-hover:text-brand-red transition-colors mb-2">
                {coach.nombre}
              </h3>
              <p class="text-slate-600 text-xs font-semibold mb-3">
                {coach.cargo}
              </p>
              <div class="p-3 bg-slate-50 rounded-xl border border-slate-100 mb-4">
                <p class="text-slate-600 text-xs italic leading-relaxed">
                  "{coach.cita}"
                </p>
              </div>
            </div>
          </div>

          <!-- Bottom bar -->
          <div class="px-6 pb-6 pt-0 bg-white">
            <a
              href="/entrenadores"
              class="inline-flex items-center gap-1.5 text-xs font-extrabold text-navy-900 hover:text-brand-red transition-colors group/link"
            >
              <span>Ver perfil y titulación</span>
              <svg class="w-3.5 h-3.5 text-brand-red group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA to dedicated page -->
    <div class="text-center reveal">
      <a
        href="/entrenadores"
        class="inline-flex items-center gap-3 px-8 py-4 rounded-full bg-navy-900 hover:bg-navy-950 text-white font-extrabold text-sm transition-all hover:scale-105 shadow-xl border border-blue-400/20"
        id="cta-ver-entrenadores"
      >
        <span>Conoce al equipo técnico completo en detalle</span>
        <svg class="w-4 h-4 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
