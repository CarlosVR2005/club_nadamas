---
/* UltimasNoticias: Homepage preview section of latest news & competition results */
import { noticias } from '../data/noticias';

const noticiasPreview = noticias.slice(0, 3);
---

<section id="noticias-preview" class="relative section-padding bg-ocean-900/50 scroll-mt-24">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row items-center justify-between mb-12 gap-6">
      <div>
        <span class="inline-block px-4 py-1.5 rounded-full bg-cyan-400/10 text-cyan-400 text-xs font-semibold tracking-widest uppercase mb-3">
          Competiciones y Medallas
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white">
          Últimas <span class="gradient-text">Noticias</span>
        </h2>
      </div>
      <a
        href="/noticias"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white/10 hover:bg-cyan-400/20 border border-white/15 text-white hover:text-cyan-400 font-semibold text-sm transition-all hover:scale-105"
      >
        <span>Ver todas las noticias</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {noticiasPreview.map((item) => (
        <a href={`/noticias/${item.slug}`} class="glass-card hover-lift p-6 flex flex-col justify-between group border border-white/10">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="px-3 py-1 rounded-full bg-cyan-400/10 text-cyan-400 text-xs font-semibold">
                {item.categoria}
              </span>
              <span class="text-white/40 text-xs">{item.fecha}</span>
            </div>
            <h3 class="text-lg font-bold text-white mb-2 group-hover:text-cyan-400 transition-colors">
              {item.titulo}
            </h3>
            <p class="text-white/60 text-xs leading-relaxed mb-4">
              {item.resumen}
            </p>
          </div>
          <div class="pt-4 border-t border-white/10 flex items-center justify-between">
            <span class="text-xs font-bold text-gold-400">🏆 {item.autor}</span>
            <span class="text-xs text-cyan-400 font-semibold group-hover:translate-x-1 transition-transform">
              Leer noticia →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
