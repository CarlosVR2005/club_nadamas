---
/* UltimasNoticias: Homepage preview section of latest news & competition results */
import { noticias, formatCategoria } from '../data/noticias';

const noticiasPreview = noticias.slice(0, 3);
---

<section id="noticias-preview" class="relative section-padding bg-white scroll-mt-24">

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row items-center justify-between mb-12 gap-6 reveal">
      <div>
        <span class="inline-block px-4 py-1.5 rounded-full bg-[#ED1C24]/10 text-[#ED1C24] text-xs font-bold tracking-widest uppercase mb-3 font-heading">
          Competiciones y Medallas
        </span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#00226D] font-heading">
          Últimas <span class="text-[#ED1C24]">Noticias</span>
        </h2>
      </div>
      <a
        href="/noticias"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-[#00226D] hover:bg-[#00123D] text-white font-bold text-sm transition-all hover:scale-105 shadow-md shrink-0"
      >
        <span>Ver todas las noticias</span>
        <svg class="w-4 h-4 text-[#ED1C24]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {noticiasPreview.map((item, idx) => (
        <a href={`/noticias/${item.slug}`} class={`card-modern overflow-hidden border-slate-200 flex flex-col group hover:border-[#ED1C24]/50 reveal-delay-${idx + 1}`}>
          <div class="relative h-48 overflow-hidden bg-slate-100">
            <img src={item.imagenPrincipal} alt={item.titulo} class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute top-3 left-3">
              <span class="px-3 py-1 rounded-full bg-[#ED1C24] text-white text-xs font-extrabold shadow-sm">
                {formatCategoria(item.categoria)}
              </span>
            </div>
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between bg-white">
            <div>
              <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
                <span>{item.fecha}</span>
              </div>
              <h3 class="text-lg font-bold text-[#00226D] mb-3 font-heading group-hover:text-[#ED1C24] transition-colors leading-snug">
                {item.titulo}
              </h3>
              <p class="text-slate-600 text-xs leading-relaxed mb-4 line-clamp-3">
                {item.resumen}
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-xs font-bold text-[#00226D] flex items-center gap-1">
                <span>🏆</span> C.D.N. Nadamás
              </span>
              <span class="text-xs text-[#ED1C24] font-extrabold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                Leer noticia →
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
