---
/* ComoUnirte: 3-step enrollment guide */
const pasos = [
  {
    numero: '01',
    titulo: 'Revisa tu horario',
    descripcion: 'Consulta los horarios y categorías disponibles en esta misma web. Encuentra el grupo que mejor se adapte a tu edad, nivel y disponibilidad.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    numero: '02',
    titulo: 'Contacta con nosotros',
    descripcion: 'Escríbenos por WhatsApp o llámanos para reservar tu clase de prueba gratuita. Sin compromiso, sin papeleos previos.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155" /></svg>`,
  },
  {
    numero: '03',
    titulo: 'Formaliza tu matrícula',
    descripcion: 'Tras la clase de prueba, acude a la recepción del C.D. Santa Rosa para completar la inscripción presencialmente. ¡Así de fácil!',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>`,
  },
];
---

<section id="como-unirte" class="relative section-padding bg-ocean-900/50 scroll-mt-24">
  <!-- Decorative elements -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none rotate-180">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-[40px] md:h-[60px]" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,60 C300,0 600,120 900,40 C1050,0 1150,80 1200,60 L1200,120 L0,120 Z" fill="#070f1f"></path>
    </svg>
  </div>

  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-green-400/10 text-green-400 text-xs font-semibold tracking-widest uppercase mb-4">
        Cómo Inscribirse
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Únete en <span class="gradient-text">3 pasos</span>
      </h2>
      <p class="max-w-2xl mx-auto text-white/60 text-base sm:text-lg">
        Sin inscripciones online, sin burocracia. Tan sencillo como acercarte a nadar.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Vertical connector line (desktop) -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-gradient-to-b from-cyan-400/40 via-gold-400/40 to-green-400/40 -translate-x-1/2"></div>

      <div class="space-y-8 md:space-y-16">
        {pasos.map((paso, i) => (
          <div class={`relative flex flex-col md:flex-row items-center gap-6 md:gap-12 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
            <!-- Number badge (center on desktop) -->
            <div class="relative z-10 shrink-0 w-20 h-20 rounded-2xl bg-gradient-to-br from-cyan-400 to-ocean-600 flex items-center justify-center shadow-xl shadow-cyan-500/20">
              <span class="text-2xl font-black text-white">{paso.numero}</span>
            </div>

            <!-- Card -->
            <div class="glass-card hover-lift p-6 md:p-8 flex-1 max-w-lg">
              <div class="flex items-center gap-3 mb-3 text-cyan-400">
                <Fragment set:html={paso.icon} />
                <h3 class="text-xl font-bold text-white">{paso.titulo}</h3>
              </div>
              <p class="text-white/60 text-sm leading-relaxed">{paso.descripcion}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Final CTA -->
    <div class="mt-16 text-center">
      <a
        href="https://wa.me/34600000000?text=Hola%2C%20quiero%20reservar%20una%20clase%20de%20prueba%20gratuita"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 px-8 py-4 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold text-base rounded-full shadow-xl shadow-green-500/25 hover:shadow-green-500/40 transition-all duration-300 hover:scale-105"
        id="cta-unirte-whatsapp"
      >
        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Reserva tu clase de prueba gratis
      </a>
      <p class="mt-4 text-white/40 text-sm">Sin compromiso · Respuesta en menos de 24h</p>
    </div>
  </div>
</section>
