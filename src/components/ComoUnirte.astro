---
/* ComoUnirte: 3-step enrollment guide */
const pasos = [
  {
    numero: '01',
    titulo: 'Consulta tus horarios',
    descripcion: 'Consulta los horarios y categorías disponibles en esta misma web para encontrar el grupo que mejor se adapte a tu edad y disponibilidad.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>`,
  },
  {
    numero: '02',
    titulo: 'Llama al 928 346 038',
    descripcion: 'Llama al 928 346 038 de L a V de 16:00 a 19:30 h para consultar cuotas y solicitar tu prueba de nivel.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" /></svg>`,
  },
  {
    numero: '03',
    titulo: 'Formaliza la matrícula presencialmente',
    descripcion: 'Acude a la recepción del C.D. Santa Rosa para formalizar la matrícula e inscripción presencial.',
    icon: `<svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" /></svg>`,
  },
];
---

<section id="como-unirte" class="relative section-padding bg-[#F4F7FF] scroll-mt-24">
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#ED1C24]/10 text-[#ED1C24] text-xs font-bold tracking-widest uppercase mb-4 font-heading">
        Cómo Inscribirse
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#00226D] mb-4 font-heading">
        Únete en <span class="text-[#ED1C24]">3 pasos</span>
      </h2>
      <p class="max-w-2xl mx-auto text-slate-600 text-base sm:text-lg">
        Proceso directo: infórmate por teléfono y formaliza la inscripción presencialmente.
      </p>
    </div>

    <!-- Steps -->
    <div class="relative">
      <!-- Vertical connector line (desktop) -->
      <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-[#ED1C24] via-[#00226D] to-[#ED1C24] -translate-x-1/2 opacity-30 rounded-full"></div>

      <div class="space-y-8 md:space-y-12">
        {pasos.map((paso, i) => (
          <div class={`relative flex flex-col md:flex-row items-center gap-6 md:gap-12 ${i % 2 === 1 ? 'md:flex-row-reverse' : ''} reveal-delay-${i + 1}`}>
            <!-- Number badge (center on desktop) -->
            <div class="relative z-10 shrink-0 w-20 h-20 rounded-2xl bg-[#00226D] text-white border-2 border-[#ED1C24] flex items-center justify-center shadow-xl">
              <span class="text-2xl font-black font-heading">{paso.numero}</span>
            </div>

            <!-- Card -->
            <div class="card-modern p-6 md:p-8 flex-1 max-w-lg border-slate-200 hover:border-[#ED1C24]/50">
              <div class="flex items-center gap-3 mb-3 text-[#ED1C24]">
                <Fragment set:html={paso.icon} />
                <h3 class="text-xl font-bold text-[#00226D] font-heading">{paso.titulo}</h3>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed">{paso.descripcion}</p>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Final CTA -->
    <div class="mt-16 text-center flex flex-col items-center gap-3 reveal-delay-3">
      <a
        href="tel:928346038"
        class="btn-cta-primary inline-flex items-center gap-3 px-8 py-4 text-base shadow-xl"
        id="cta-unirte-telefono"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
        </svg>
        Llamar al 928 346 038
      </a>
      <p class="text-xs font-semibold text-[#00226D] bg-white px-4 py-2 rounded-full border border-slate-200 shadow-sm">
        Horario de atención telefónica: Lunes a Viernes de 16:00 a 19:30 h
      </p>
    </div>
  </div>
</section>
