---
/* Programas: Swimming categories grid */
const programas = [
  {
    icon: `<svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" /></svg>`,
    title: "Escuela de Natación",
    age: "3 a 16 años",
    horario: "Lunes a Viernes: 16:00 a 19:00 h",
    description:
      "Aprendizaje de los cuatro estilos, técnica básica y evolución deportiva adaptada al nivel de cada alumno.",
    iconBg: "bg-brand-red",
    badgeBg: "bg-brand-red/10 text-brand-red",
  },
  {
    icon: `<svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>`,
    title: "Escuela de Adultos",
    age: "Iniciación y Perfeccionamiento",
    horario: "L, M, V: 09:00-10:00 h | M, J: 19:00-20:00 h",
    description:
      "Entrenamientos adaptados para adultos que desean iniciarse o mejorar su técnica y condición física.",
    iconBg: "bg-navy-900",
    badgeBg: "bg-navy-900/10 text-navy-900",
  },
  {
    icon: `<svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>`,
    title: "Natación para Bebés",
    age: "Bebés y Pequeños",
    horario: "L-V: 18:00-18:30 h | Sáb: 10:00-12:00 h",
    description:
      "Iniciación y estimulación acuática en un entorno seguro y adaptado para los más pequeños.",
    iconBg: "bg-brand-red",
    badgeBg: "bg-brand-red/10 text-brand-red",
  },
  {
    icon: `<svg class="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`,
    title: "Cantera y Competición",
    age: "Federados",
    horario: "Planificación de alto rendimiento",
    description:
      "Entrenamientos avanzados para nadadores federados que compiten en campeonatos regionales y nacionales.",
    iconBg: "bg-navy-950",
    badgeBg: "bg-navy-900/10 text-navy-900",
  },
];
---

<section id="programas" class="relative section-padding bg-white scroll-mt-24">
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16 reveal">
      <span
        class="inline-block px-4 py-1.5 rounded-full bg-brand-red/10 text-brand-red text-xs font-bold tracking-widest uppercase mb-4 font-heading"
      >
        Nuestros Programas
      </span>
      <h2
        class="text-3xl sm:text-4xl md:text-5xl font-black text-navy-900 mb-4 font-heading"
      >
        Encuentra tu <span class="text-brand-red">categoría</span>
      </h2>
      <p class="max-w-2xl mx-auto text-slate-600 text-base sm:text-lg">
        Desde iniciación infantil hasta natación máster y competición federada.
      </p>
    </div>

    <!-- Programs Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
      {
        programas.map((prog, idx) => (
          <div
            class={`card-modern p-8 flex flex-col justify-between group border-slate-200 hover:border-brand-red/50 reveal-delay-${idx + 1}`}
          >
            <div>
              <div class="flex items-start gap-4 mb-5">
                <div
                  class={`shrink-0 w-14 h-14 rounded-2xl ${prog.iconBg} flex items-center justify-center shadow-lg group-hover:scale-105 transition-transform duration-300`}
                >
                  <Fragment set:html={prog.icon} />
                </div>
                <div>
                  <h3 class="text-xl font-bold text-navy-900 font-heading group-hover:text-brand-red transition-colors">
                    {prog.title}
                  </h3>
                  <span
                    class={`inline-block mt-1 px-3 py-0.5 rounded-full text-xs font-bold ${prog.badgeBg}`}
                  >
                    {prog.age}
                  </span>
                </div>
              </div>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {prog.description}
              </p>
            </div>
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between text-xs">
              <span class="text-navy-900 font-semibold flex items-center gap-1.5">
                <svg
                  class="w-4 h-4 text-brand-red"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"
                  />
                </svg>
                {prog.horario}
              </span>
              <a
                href="#horarios"
                class="text-brand-red font-bold hover:underline flex items-center gap-1"
              >
                Ver horario completo →
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
