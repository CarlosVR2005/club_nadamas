---
/* Programas: Swimming categories grid */
const programas = [
  {
    icon: `<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" /></svg>`,
    title: 'Escuela e Iniciación',
    age: 'Desde 4 años',
    description: 'Primeros contactos con el agua en un entorno seguro y divertido. Aprendizaje de los cuatro estilos, técnica básica y confianza en el medio acuático.',
    color: 'from-cyan-400 to-cyan-500',
    borderColor: 'border-cyan-400/20 hover:border-cyan-400/40',
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>`,
    title: 'Cantera / Competición',
    age: 'Federados',
    description: 'Entrenamiento de alto rendimiento para nadadores federados. Preparación para campeonatos regionales y nacionales con planificación individualizada.',
    color: 'from-gold-400 to-gold-500',
    borderColor: 'border-gold-400/20 hover:border-gold-400/40',
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" /></svg>`,
    title: 'Natación Máster',
    age: '+18 años',
    description: 'Para adultos que buscan mantenerse en forma, perfeccionar su técnica o competir en categoría máster. Entrenamientos adaptados a todos los niveles.',
    color: 'from-ocean-400 to-cyan-500',
    borderColor: 'border-ocean-400/20 hover:border-ocean-400/40',
  },
  {
    icon: `<svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" /></svg>`,
    title: 'Aguas Abiertas',
    age: 'Travesías',
    description: 'Preparación específica para travesías a nado y competiciones en aguas abiertas. Estrategia, orientación y resistencia en el mar de Lanzarote.',
    color: 'from-cyan-500 to-ocean-400',
    borderColor: 'border-cyan-500/20 hover:border-cyan-500/40',
  },
];
---

<section id="programas" class="relative section-padding bg-ocean-900/50 scroll-mt-24">
  <!-- Wave top -->
  <div class="absolute top-0 left-0 w-full overflow-hidden leading-none rotate-180">
    <svg viewBox="0 0 1200 120" preserveAspectRatio="none" class="w-full h-[40px] md:h-[60px]" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,60 C200,120 400,0 600,60 C800,120 1000,0 1200,60 L1200,120 L0,120 Z" fill="#070f1f"></path>
    </svg>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <span class="inline-block px-4 py-1.5 rounded-full bg-cyan-400/10 text-cyan-400 text-xs font-semibold tracking-widest uppercase mb-4">
        Nuestros Programas
      </span>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white mb-4">
        Encuentra tu <span class="gradient-text">categoría</span>
      </h2>
      <p class="max-w-2xl mx-auto text-white/60 text-base sm:text-lg">
        Desde los primeros chapoteos hasta la competición de alto nivel. Tenemos un lugar para ti en el agua.
      </p>
    </div>

    <!-- Programs Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 lg:gap-8">
      {programas.map((prog) => (
        <div class={`glass-card hover-lift p-8 border ${prog.borderColor} transition-all duration-300 group`}>
          <div class="flex items-start gap-4 mb-4">
            <div class={`shrink-0 w-16 h-16 rounded-2xl bg-gradient-to-br ${prog.color} flex items-center justify-center text-white shadow-lg`}>
              <Fragment set:html={prog.icon} />
            </div>
            <div>
              <h3 class="text-xl font-bold text-white group-hover:text-cyan-400 transition-colors">{prog.title}</h3>
              <span class="inline-block mt-1 px-3 py-0.5 rounded-full bg-white/10 text-white/70 text-xs font-medium">{prog.age}</span>
            </div>
          </div>
          <p class="text-white/60 text-sm leading-relaxed">{prog.description}</p>
          <div class="mt-6 flex items-center gap-2 text-cyan-400 text-sm font-medium group-hover:gap-3 transition-all">
            <span>Más información</span>
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
