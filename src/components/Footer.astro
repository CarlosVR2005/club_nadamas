---
/* Footer: Links, social media, legal */
const currentYear = new Date().getFullYear();

const quickLinks = [
  { label: 'Inicio', href: '/#inicio' },
  { label: 'El Club', href: '/#palmares' },
  { label: 'Categorías', href: '/#programas' },
  { label: 'Horarios', href: '/#horarios' },
  { label: 'Noticias', href: '/noticias' },
  { label: 'Contacto', href: '/#contacto' },
];

const socialLinks = [
  {
    label: 'Instagram',
    href: 'https://instagram.com/clubnadamas',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/></svg>`,
  },
  {
    label: 'Facebook',
    href: 'https://facebook.com/clubnadamas',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`,
  },
  {
    label: 'YouTube',
    href: 'https://youtube.com/@clubnadamas',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>`,
  },
];
---

<footer class="relative bg-ocean-900 border-t border-white/10">
  <!-- Wave top decoration -->
  <div class="absolute -top-[1px] left-0 w-full overflow-hidden leading-none rotate-180">
    <svg viewBox="0 0 1200 60" preserveAspectRatio="none" class="w-full h-[30px] md:h-[40px]" xmlns="http://www.w3.org/2000/svg">
      <path d="M0,30 C200,60 400,0 600,30 C800,60 1000,0 1200,30 L1200,60 L0,60 Z" fill="#122c55"></path>
    </svg>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16 pb-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-12">
      <!-- Club Info -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-full bg-gradient-to-br from-cyan-400 to-ocean-600 flex items-center justify-center">
            <svg class="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 15c2.483 0 4.345-1.5 6-3s3.517-3 6-3 4.345 1.5 6 3" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 19c2.483 0 4.345-1.5 6-3s3.517-3 6-3 4.345 1.5 6 3" />
            </svg>
          </div>
          <div>
            <p class="text-white font-bold text-lg">Nadamás</p>
            <p class="text-cyan-400 text-xs font-medium tracking-wider uppercase">Las Marinas</p>
          </div>
        </div>
        <p class="text-white/50 text-sm leading-relaxed">
          Club de natación vinculado al C.D. Santa Rosa en Costa Teguise, Lanzarote. Formando campeones y promoviendo la natación en Canarias desde hace más de dos décadas.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-widest mb-4">Enlaces Rápidos</h4>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a href={link.href} class="text-white/50 hover:text-cyan-400 text-sm transition-colors inline-flex items-center gap-2 group">
                <svg class="w-3 h-3 text-cyan-400/50 group-hover:text-cyan-400 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                </svg>
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Social + Legal -->
      <div>
        <h4 class="text-white font-bold text-sm uppercase tracking-widest mb-4">Síguenos</h4>
        <div class="flex items-center gap-3 mb-6">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="w-10 h-10 rounded-xl bg-white/10 hover:bg-cyan-400/20 flex items-center justify-center text-white/60 hover:text-cyan-400 transition-all duration-300"
              aria-label={social.label}
            >
              <Fragment set:html={social.icon} />
            </a>
          ))}
        </div>
        <div class="space-y-2">
          <a href="#" class="block text-white/40 hover:text-white/60 text-xs transition-colors">Aviso Legal</a>
          <a href="#" class="block text-white/40 hover:text-white/60 text-xs transition-colors">Política de Privacidad</a>
          <a href="#" class="block text-white/40 hover:text-white/60 text-xs transition-colors">Política de Cookies</a>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-white/10 pt-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <p class="text-white/30 text-xs text-center sm:text-left">
        &copy; {currentYear} C.D. Nadamás Las Marinas. Todos los derechos reservados.
      </p>
      <p class="text-white/20 text-xs">
        Costa Teguise, Lanzarote 🏝️
      </p>
    </div>
  </div>
</footer>
