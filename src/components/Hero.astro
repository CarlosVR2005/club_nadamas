---
/* Hero: Full-screen section with background image, bold headline, CTAs and wave divider */
---

<section
  id="inicio"
  class="relative min-h-screen flex items-center justify-center overflow-hidden bg-navy-950"
>
  <!-- Background Image with Motion Blur/Zoom effect -->
  <div class="absolute inset-0 overflow-hidden">
    <img
      src="/hero-swimming.png"
      alt="Nadadores compitiendo en piscina"
      class="w-full h-full object-cover scale-105 transition-all duration-1000 ease-out filter brightness-[0.70] contrast-110"
      loading="eager"
    />
    <div
      class="absolute inset-0 bg-gradient-to-b from-navy-950/65 via-navy-900/50 to-navy-950/85"
    >
    </div>
  </div>

  <!-- Background Graphic: Swimmer silhouette watermark / Logo Graphic -->
  <div class="absolute inset-0 flex items-center justify-center opacity-10 pointer-events-none">
    <img src="/logo-club.png" alt="" class="w-[500px] h-[500px] object-contain filter invert opacity-20" />
  </div>

  <!-- Floating decorative elements -->
  <div
    class="absolute top-20 left-10 w-72 h-72 bg-brand-red/10 rounded-full blur-3xl"
  >
  </div>
  <div
    class="absolute bottom-32 right-10 w-96 h-96 bg-navy-900/30 rounded-full blur-3xl"
  >
  </div>

  <!-- Content -->
  <div
    class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center pt-28 pb-32"
  >
    <!-- Badge -->
    <div
      class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/10 backdrop-blur-md border border-white/20 mb-8 shadow-md"
    >
      <span class="w-2.5 h-2.5 rounded-full bg-brand-red animate-pulse"></span>
      <span
        class="text-white text-xs sm:text-sm font-semibold tracking-wider uppercase font-heading"
        >C.D. Nadamás Santa Rosa · Costa Teguise</span
      >
    </div>

    <!-- Title -->
    <h1
      class="reveal-delay-1 text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-tight mb-6 font-heading tracking-tight"
    >
      <span class="bg-gradient-to-r from-white via-slate-100 to-blue-400 bg-clip-text text-transparent drop-shadow-md">
        Tradición y Campeones
      </span>
      <br />
      <span class="bg-gradient-to-r from-white via-blue-200 to-sky-400 bg-clip-text text-transparent">
        de Lanzarote
      </span>
    </h1>

    <!-- Subtitle -->
    <p
      class="reveal-delay-2 max-w-2xl mx-auto text-base sm:text-lg md:text-xl text-slate-200 mb-10 leading-relaxed font-normal"
    >
      Desde el <strong class="text-white font-semibold">C.D. Nadamás Santa Rosa</strong>,
      formamos nadadores que destacan en
      <strong class="text-gold-400 font-semibold"> Campeonatos de Canarias</strong> y
      <strong class="text-gold-400 font-semibold"> España</strong>. Únete a nuestra familia deportiva.
    </p>

    <!-- CTA Buttons -->
    <div
      class="reveal-delay-3 flex flex-col items-center justify-center gap-4"
    >
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full sm:w-auto">
        <!-- CTA Llamar: Rojo Intenso -->
        <a
          href="tel:928346038"
          class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-brand-red hover:bg-brand-red-hover text-white font-extrabold text-base rounded-full shadow-xl shadow-red-500/30 hover:shadow-red-500/50 transition-all duration-300 hover:scale-105 border border-red-400/40 w-full sm:w-auto"
          id="cta-hero-telefono"
        >
          <svg
            class="w-5 h-5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
            ></path>
          </svg>
          Llamar para Información
        </a>

        <!-- CTA Ver Horarios: Navy Outline -->
        <a
          href="#horarios"
          class="group inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 text-white font-bold text-base rounded-full backdrop-blur-md border border-white/25 transition-all duration-300 hover:scale-105 w-full sm:w-auto"
          id="cta-hero-horarios"
        >
          <svg
            class="w-5 h-5 text-brand-red"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          Ver Horarios
        </a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="mt-16 flex flex-col items-center gap-2 opacity-60">
      <span class="text-xs text-slate-300 tracking-widest uppercase font-semibold"
        >Descubre más</span
      >
      <div
        class="w-6 h-10 rounded-full border-2 border-white/30 flex items-start justify-center p-1.5"
      >
        <div class="w-1.5 h-3 bg-brand-red rounded-full animate-bounce"></div>
      </div>
    </div>
  </div>

  <!-- Wave divider -->
  <div class="wave-divider">
    <svg
      viewBox="0 0 1200 120"
      preserveAspectRatio="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M0,60 C200,120 400,0 600,60 C800,120 1000,0 1200,60 L1200,120 L0,120 Z"
        fill="#ffffff"></path>
    </svg>
  </div>
</section>
