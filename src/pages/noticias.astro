---
import Layout from '../layouts/Layout.astro';
import { noticias } from '../data/noticias';
---

<Layout
  title="Noticias y Resultados | C.D. Nadamás Las Marinas Lanzarote"
  description="Mantente al día de las competiciones, resultados, medallas y trofeos logrados por los nadadores del C.D. Nadamás Las Marinas en Lanzarote y Canarias."
>
  <!-- Hero Header Noticias -->
  <section class="relative pt-32 pb-20 bg-gradient-to-b from-ocean-950 via-ocean-900 to-ocean-950 overflow-hidden">
    <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-400/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 left-0 w-96 h-96 bg-gold-400/5 rounded-full blur-3xl"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-block px-4 py-1.5 rounded-full bg-cyan-400/10 text-cyan-400 text-xs font-semibold tracking-widest uppercase mb-4">
        Actualidad Deportiva
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white mb-6">
        Noticias y <span class="gradient-text">Resultados</span>
      </h1>
      <p class="max-w-2xl mx-auto text-white/70 text-base sm:text-lg">
        Sigue los éxitos de nuestros nadadores, los podios logrados en Canarias y España, y las últimas novedades del C.D. Nadamás Las Marinas.
      </p>
    </div>
  </section>

  <!-- News Grid Section -->
  <section class="py-16 bg-ocean-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Featured Article (First one) -->
      {noticias.filter(n => n.destacado).map((art) => (
        <a href={`/noticias/${art.slug}`} class="block glass-card hover-lift overflow-hidden border border-cyan-400/30 mb-16 group">
          <div class="grid lg:grid-cols-12 gap-8 items-center p-6 lg:p-8">
            <div class="lg:col-span-7 relative h-64 lg:h-96 rounded-2xl overflow-hidden">
              <img src={art.imagen} alt={art.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full bg-gold-400 text-ocean-950 font-bold text-xs shadow-lg uppercase tracking-wide">
                  Destacado
                </span>
              </div>
            </div>
            <div class="lg:col-span-5 flex flex-col justify-center">
              <div class="flex items-center gap-3 text-xs text-white/50 mb-3">
                <span class="px-3 py-1 rounded-full bg-cyan-400/10 text-cyan-400 font-semibold">{art.categoria}</span>
                <span>•</span>
                <span>{art.fecha}</span>
                <span>•</span>
                <span>{art.tiempoLectura}</span>
              </div>
              <h2 class="text-2xl lg:text-3xl font-extrabold text-white mb-4 group-hover:text-cyan-400 transition-colors">
                {art.titulo}
              </h2>
              <p class="text-white/70 text-sm leading-relaxed mb-6">
                {art.resumen}
              </p>
              <div class="inline-flex items-center gap-2 text-cyan-400 font-bold text-sm group-hover:gap-3 transition-all">
                <span>Leer noticia completa</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}

      <!-- Grid for other articles -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {noticias.filter(n => !n.destacado).map((item) => (
          <a href={`/noticias/${item.slug}`} class="glass-card hover-lift overflow-hidden border border-white/10 flex flex-col group">
            <div class="relative h-48 overflow-hidden">
              <img src={item.imagen} alt={item.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute top-3 left-3">
                <span class="px-3 py-1 rounded-full bg-ocean-900/90 backdrop-blur-md text-cyan-400 text-xs font-semibold">
                  {item.categoria}
                </span>
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-xs text-white/40 mb-2">
                  <span>{item.fecha}</span>
                  <span>•</span>
                  <span>{item.tiempoLectura}</span>
                </div>
                <h3 class="text-lg font-bold text-white mb-3 group-hover:text-cyan-400 transition-colors">
                  {item.titulo}
                </h3>
                <p class="text-white/60 text-xs leading-relaxed mb-4">
                  {item.resumen}
                </p>
              </div>
              <div class="pt-4 border-t border-white/10 flex items-center justify-between">
                <span class="text-xs text-white/50">{item.autor}</span>
                <span class="text-xs text-cyan-400 font-semibold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  Leer noticia →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Join Banner -->
  <section class="py-12 bg-ocean-900 border-t border-white/10">
    <div class="max-w-5xl mx-auto px-4 text-center">
      <h3 class="text-2xl font-bold text-white mb-2">¿Quieres formar parte de nuestros próximos éxitos?</h3>
      <p class="text-white/60 text-sm mb-6">Ven a probar una clase gratuita en la piscina del C.D. Santa Rosa.</p>
      <a
        href="https://wa.me/34600000000?text=Hola%2C%20he%20visto%20las%20noticias%20y%20me%20gustar%C3%ADa%20probar%20una%20clase"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white font-bold text-sm rounded-full shadow-lg transition-all hover:scale-105"
      >
        Contactar por WhatsApp
      </a>
    </div>
  </section>
</Layout>
