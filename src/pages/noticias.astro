---
import Layout from '../layouts/Layout.astro';
import { noticias } from '../data/noticias';
---

<Layout
  title="Noticias y Resultados | C.D. Nadamás Las Marinas Lanzarote"
  description="Mantente al día de las competiciones, resultados, medallas y trofeos logrados por los nadadores del C.D. Nadamás Las Marinas en Lanzarote y Canarias."
>
  <!-- Hero Header Noticias -->
  <section class="relative pt-32 pb-20 bg-[#00123D] text-white overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <span class="inline-block px-4 py-1.5 rounded-full bg-[#ED1C24]/20 text-[#ED1C24] text-xs font-bold tracking-widest uppercase mb-4 font-heading border border-[#ED1C24]/30">
        Actualidad Deportiva
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white mb-6 font-heading">
        Noticias y <span class="text-[#ED1C24]">Resultados</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-300 text-base sm:text-lg">
        Sigue los éxitos de nuestros nadadores, los podios logrados en Canarias y España, y las últimas novedades del C.D. Nadamás Las Marinas.
      </p>
    </div>
  </section>

  <!-- News Grid Section -->
  <section class="py-16 bg-[#F4F7FF]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Featured Article (First one) -->
      {noticias.filter(n => n.destacado).map((art) => (
        <a href={`/noticias/${art.slug}`} class="block card-modern overflow-hidden border-slate-200 hover:border-[#ED1C24]/50 mb-16 group reveal">
          <div class="grid lg:grid-cols-12 gap-8 items-center p-6 lg:p-8">
            <div class="lg:col-span-7 relative h-64 lg:h-96 rounded-2xl overflow-hidden">
              <img src={art.imagen} alt={art.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute top-4 left-4">
                <span class="px-3 py-1 rounded-full bg-[#ED1C24] text-white font-extrabold text-xs shadow-lg uppercase tracking-wide">
                  Destacado
                </span>
              </div>
            </div>
            <div class="lg:col-span-5 flex flex-col justify-center">
              <div class="flex items-center gap-3 text-xs text-slate-500 mb-3">
                <span class="px-3 py-1 rounded-full bg-[#00226D]/10 text-[#00226D] font-bold">{art.categoria}</span>
                <span>•</span>
                <span>{art.fecha}</span>
                <span>•</span>
                <span>{art.tiempoLectura}</span>
              </div>
              <h2 class="text-2xl lg:text-3xl font-extrabold text-[#00226D] mb-4 font-heading group-hover:text-[#ED1C24] transition-colors">
                {art.titulo}
              </h2>
              <p class="text-slate-600 text-sm leading-relaxed mb-6">
                {art.resumen}
              </p>
              <div class="inline-flex items-center gap-2 text-[#ED1C24] font-bold text-sm group-hover:gap-3 transition-all">
                <span>Leer noticia completa</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </div>
            </div>
          </div>
        </a>
      ))}

      <!-- Grid for other articles -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {noticias.filter(n => !n.destacado).map((item, idx) => (
          <a href={`/noticias/${item.slug}`} class={`card-modern overflow-hidden border-slate-200 flex flex-col group hover:border-[#ED1C24]/40 reveal-delay-${(idx % 3) + 1}`}>
            <div class="relative h-48 overflow-hidden">
              <img src={item.imagen} alt={item.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              <div class="absolute top-3 left-3">
                <span class="px-3 py-1 rounded-full bg-[#00226D] text-white text-xs font-bold shadow-sm">
                  {item.categoria}
                </span>
              </div>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-xs text-slate-500 mb-2">
                  <span>{item.fecha}</span>
                  <span>•</span>
                  <span>{item.tiempoLectura}</span>
                </div>
                <h3 class="text-lg font-bold text-[#00226D] mb-3 font-heading group-hover:text-[#ED1C24] transition-colors">
                  {item.titulo}
                </h3>
                <p class="text-slate-600 text-xs leading-relaxed mb-4">
                  {item.resumen}
                </p>
              </div>
              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <span class="text-xs text-slate-400 font-medium">{item.autor}</span>
                <span class="text-xs text-[#ED1C24] font-bold group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  Leer noticia →
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Join Banner -->
  <section class="py-12 bg-[#00226D] text-white border-t border-slate-700">
    <div class="max-w-5xl mx-auto px-4 text-center space-y-3 reveal">
      <h3 class="text-2xl font-bold text-white mb-2 font-heading">¿Quieres formar parte de nuestros próximos éxitos?</h3>
      <p class="text-slate-300 text-sm mb-4">Llama para consultar cuotas y prueba de nivel en el C.D. Santa Rosa.</p>
      <div>
        <a
          href="tel:928346038"
          class="btn-cta-primary inline-flex items-center gap-2 px-6 py-3 text-sm shadow-lg"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Llamar al 928 346 038
        </a>
      </div>
      <p class="text-xs text-slate-300 font-medium">
        Horario de atención: Lunes a Viernes de 16:00 a 19:30 h en la recepción del C.D. Santa Rosa
      </p>
    </div>
  </section>
</Layout>
