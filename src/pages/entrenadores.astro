---
import Layout from '../layouts/Layout.astro';
import { entrenadores } from '../data/entrenadores';
---

<Layout
  title="Equipo Técnico y Entrenadores | C.N. Nadamás Las Marinas"
  description="Conoce al equipo de entrenadores titulados del C.N. Nadamás Las Marinas en Costa Teguise. Profesionales al servicio del rendimiento y la formación acuática."
>
  <!-- Hero Header -->
  <section class="relative pt-32 pb-20 bg-navy-950 text-white overflow-hidden">
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center reveal">
      <span class="inline-block px-4 py-1.5 rounded-full bg-brand-red/20 text-brand-red text-xs font-bold tracking-widest uppercase mb-4 font-heading border border-brand-red/30">
        Cuerpo Técnico Oficial
      </span>
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-black text-white mb-6 font-heading">
        Nuestro <span class="text-brand-red">Equipo Técnico</span>
      </h1>
      <p class="max-w-2xl mx-auto text-slate-300 text-base sm:text-lg">
        Profesionales de la natación titulados por la Real Federación Española de Natación (RFEN) que forman, guían y entrenan a nuestros deportistas en el C.N. Nadamás Las Marinas.
      </p>
    </div>
  </section>

  <!-- Coaches Showcase Section -->
  <section class="py-16 bg-navy-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      {entrenadores.map((coach, idx) => (
        <div class={`card-modern overflow-hidden border-slate-200 p-6 md:p-8 hover:border-brand-red/50 reveal-delay-${(idx % 3) + 1}`}>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
            <!-- Image Column -->
            <div class="md:col-span-4 relative h-72 md:h-80 rounded-2xl overflow-hidden shadow-lg bg-navy-950">
              <img
                src={coach.imagen}
                alt={coach.nombre}
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-navy-950/80 via-transparent to-transparent"></div>
              <div class="absolute bottom-4 left-4 right-4 flex justify-between items-center text-xs text-white font-bold">
                <span class="px-3 py-1 rounded-full bg-brand-red shadow-md uppercase tracking-wider text-[10px]">
                  {coach.experiencia}
                </span>
                <span class="text-slate-300">C.N. Nadamás Las Marinas</span>
              </div>
            </div>

            <!-- Bio Column -->
            <div class="md:col-span-8 space-y-4">
              <div>
                <span class="inline-block px-3 py-1 rounded-full bg-navy-900/10 text-navy-900 text-xs font-extrabold uppercase tracking-wider mb-2">
                  {coach.cargo}
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-navy-900 font-heading">
                  {coach.nombre}
                </h2>
                <p class="text-brand-red font-bold text-sm">
                  {coach.especialidad}
                </p>
              </div>

              <!-- Titulación -->
              <div class="flex items-center gap-2 text-xs font-semibold text-slate-700 bg-white p-3 rounded-xl border border-slate-200 inline-block shadow-sm">
                <span>🎓</span>
                <span>{coach.titulacion}</span>
              </div>

              <!-- Bio -->
              <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                {coach.bio}
              </p>

              <!-- Quote Box -->
              <div class="p-4 bg-slate-50 border-l-4 border-brand-red rounded-r-xl">
                <p class="text-navy-900 text-xs sm:text-sm italic font-medium">
                  "{coach.cita}"
                </p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-12 bg-navy-900 text-white border-t border-slate-700">
    <div class="max-w-5xl mx-auto px-4 text-center space-y-3 reveal">
      <h3 class="text-2xl font-bold text-white mb-2 font-heading">¿Quieres consultar con nuestro cuerpo técnico?</h3>
      <p class="text-slate-300 text-sm mb-4">Llama para solicitar tu prueba de nivel personalizada con los entrenadores del C.N. Nadamás Las Marinas.</p>
      <div>
        <a
          href="tel:928346038"
          class="btn-cta-primary inline-flex items-center gap-2 px-6 py-3 text-sm shadow-lg"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Llamar al 928 346 038
        </a>
      </div>
      <p class="text-xs text-slate-300 font-medium">
        Atención telefónica: Lunes a Viernes de 16:00 a 19:30 h (pedir hablar con el centro deportivo)
      </p>
    </div>
  </section>
</Layout>
