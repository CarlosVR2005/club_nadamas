---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { noticias, formatCategoria } from '../../data/noticias';
import { getImagen } from '../../utils/images';

export function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const paragrafos = noticia.contenido.split('\n\n');

// Combine and deduplicate images for the slider
const imagePaths = Array.from(
  new Set([noticia.imagenPrincipal, ...(noticia.imagenes || [])])
);

// The carousel/lightbox below is driven by client-side script that reads
// plain URL strings from src/data-full-img attributes, so the <Image>/
// <Picture> components (which render markup, not a URL) don't fit here.
// getImage() is the low-level astro:assets API: it optimizes at build time
// and hands back a plain .src string we can drop straight into those
// attributes without touching the existing carousel/lightbox script.
const allImages = await Promise.all(
  imagePaths.map(async (path) => {
    const source = getImagen(path);
    const [blurBg, display, thumb, full] = await Promise.all([
      getImage({ src: source, width: 500, format: 'avif', quality: 40 }),
      getImage({ src: source, width: 1400, format: 'avif', quality: 75 }),
      getImage({ src: source, width: 400, format: 'avif', quality: 65 }),
      getImage({ src: source, width: 2000, format: 'avif', quality: 82 }),
    ]);
    return { blurBg: blurBg.src, display: display.src, thumb: thumb.src, full: full.src };
  })
);
---

<Layout
  title={`${noticia.titulo} | C.D. Nadamás Santa Rosa`}
  description={noticia.resumen}
>
  <!-- Article Header & Body -->
  <article class="pt-28 pb-20 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back button -->
      <div class="mb-8">
        <a
          href="/noticias"
          class="inline-flex items-center gap-2 text-brand-red hover:underline font-bold text-sm transition-colors group"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Volver a Noticias
        </a>
      </div>

      <!-- Meta badges -->
      <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
        <span class="px-3 py-1 rounded-full bg-brand-red/10 text-brand-red font-bold uppercase tracking-wider border border-brand-red/30">
          {formatCategoria(noticia.categoria)}
        </span>
        <span class="text-slate-400">•</span>
        <span class="text-slate-500 font-medium">{noticia.fecha}</span>
        <span class="text-slate-400">•</span>
        <span class="text-slate-500 font-medium">C.D. Nadamás Santa Rosa</span>
      </div>

      <!-- Article Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-navy-900 leading-tight mb-6 font-heading">
        {noticia.titulo}
      </h1>

      <!-- Subtitle / Summary -->
      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8 font-medium">
        {noticia.resumen}
      </p>

      <!-- Featured Main Interactive Slider / Carousel with True Aspect Ratio -->
      <div id="news-carousel" class="relative group min-h-[350px] sm:min-h-[450px] md:min-h-[550px] max-h-[750px] rounded-3xl overflow-hidden border border-slate-800 shadow-2xl mb-12 bg-[#000d2b]">
        <!-- Slides Container -->
        <div id="carousel-slides" class="relative w-full h-full flex items-center justify-center min-h-[350px] sm:min-h-[450px] md:min-h-[550px]">
          {allImages.map((img, i) => (
            <div
              class={`carousel-slide absolute inset-0 transition-all duration-700 ease-in-out flex items-center justify-center ${i === 0 ? 'opacity-100 z-10 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'}`}
              data-slide-index={i}
            >
              <!-- Blurred Background for Letterboxing -->
              <img
                src={img.blurBg}
                alt=""
                loading={i === 0 ? 'eager' : 'lazy'}
                class="absolute inset-0 w-full h-full object-cover blur-2xl opacity-30 scale-110 pointer-events-none select-none"
              />

              <!-- Real Aspect Ratio Main Image (No cropping) -->
              <img
                src={img.display}
                alt={`Fotografía ${i + 1} de ${noticia.titulo}`}
                loading={i === 0 ? 'eager' : 'lazy'}
                class="open-lightbox relative z-10 max-h-[550px] w-auto max-w-full object-contain cursor-zoom-in transition-transform duration-300 hover:scale-[1.01] shadow-2xl rounded-lg"
                data-full-img={img.full}
              />

              <div class="absolute inset-0 bg-gradient-to-t from-[#000d2b]/80 via-transparent to-black/30 pointer-events-none"></div>
            </div>
          ))}
        </div>

        <!-- Zoom Hint Badge -->
        <div class="absolute top-4 left-4 z-20 pointer-events-none flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-semibold border border-white/20 shadow-lg">
          <svg class="w-4 h-4 text-brand-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607zM10.5 7.5v6m3-3h-6" />
          </svg>
          <span>Haz clic en la foto para ver a tamaño real</span>
        </div>

        <!-- Prev/Next Controls (only if more than 1 image) -->
        {allImages.length > 1 && (
          <>
            <button
              id="carousel-prev"
              aria-label="Foto anterior"
              class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/20 hover:bg-brand-red text-white backdrop-blur-md flex items-center justify-center transition-all duration-300 shadow-lg hover:scale-110 border border-white/30"
            >
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
              </svg>
            </button>

            <button
              id="carousel-next"
              aria-label="Foto siguiente"
              class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/20 hover:bg-brand-red text-white backdrop-blur-md flex items-center justify-center transition-all duration-300 shadow-lg hover:scale-110 border border-white/30"
            >
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
              </svg>
            </button>

            <!-- Dots Indicators -->
            <div class="absolute bottom-4 left-0 right-0 z-20 flex items-center justify-center gap-2">
              {allImages.map((_, i) => (
                <button
                  class={`carousel-dot w-3 h-3 rounded-full transition-all duration-300 ${i === 0 ? 'bg-brand-red w-8' : 'bg-white/60 hover:bg-white'}`}
                  data-dot-index={i}
                  aria-label={`Ir a la foto ${i + 1}`}
                />
              ))}
            </div>

            <!-- Counter Badge -->
            <div class="absolute top-4 right-4 z-20 px-3 py-1.5 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-bold border border-white/20 shadow-lg">
              <span id="carousel-counter">1 / {allImages.length}</span>
            </div>
          </>
        )}

        <!-- Footer Info Tag -->
        <div class="absolute bottom-4 left-6 z-20 hidden sm:flex items-center gap-2 text-xs text-white/90 font-semibold drop-shadow-md">
          <span>C.D. Nadamás Santa Rosa</span>
          <span>•</span>
          <span>Costa Teguise, Lanzarote</span>
        </div>
      </div>

      <!-- Article Body Paragraphs -->
      <div class="space-y-6 text-slate-700 text-base md:text-lg leading-relaxed font-normal mb-12">
        {paragrafos.map((para, idx) => (
          <p class={idx === 0 ? "text-navy-900 font-semibold text-lg md:text-xl leading-relaxed border-l-4 border-brand-red pl-4 py-2 bg-slate-50 rounded-r-xl" : "text-slate-700 leading-relaxed whitespace-pre-line"}>
            {para}
          </p>
        ))}
      </div>

      <!-- Article Image Gallery (Multiple Images Support with Click to Open Lightbox) -->
      {allImages.length > 1 && (
        <div class="my-12 pt-8 border-t border-slate-200">
          <div class="flex items-center justify-between mb-6">
            <div class="flex items-center gap-3">
              <span class="text-2xl">📸</span>
              <h3 class="text-xl font-bold text-navy-900 font-heading">Galería Fotográfica de la Noticia</h3>
            </div>
            <span class="text-xs font-semibold text-slate-500">Haz clic en cualquier foto para abrir a tamaño real</span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {allImages.map((img, imgIdx) => (
              <button
                class={`gallery-thumb open-lightbox relative h-52 rounded-2xl overflow-hidden border border-slate-200 shadow-md group transition-all duration-300 text-left ${imgIdx === 0 ? 'ring-4 ring-brand-red scale-105' : 'hover:scale-102'}`}
                data-thumb-index={imgIdx}
                data-full-img={img.full}
                aria-label={`Ver foto ${imgIdx + 1} a tamaño real`}
              >
                <img
                  src={img.thumb}
                  alt={`Imagen ${imgIdx + 1} de ${noticia.titulo}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-3">
                  <span class="text-white text-xs font-bold flex items-center gap-1.5">
                    <span>🔍 Tamaño Real</span>
                  </span>
                </div>
              </button>
            ))}
          </div>
        </div>
      )}

      <!-- Share & CTA Footer Box -->
      <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6 card-modern p-6 bg-slate-50">
        <div>
          <h4 class="text-navy-900 font-bold text-base mb-1 font-heading">¿Quieres entrenar con nosotros?</h4>
          <p class="text-slate-600 text-xs">Consulta cuotas y prueba de nivel llamando al 928 346 038 (L a V 16:00-19:30 h).</p>
        </div>
        <a
          href="tel:928346038"
          class="btn-cta-primary inline-flex items-center gap-2 px-6 py-3 text-sm shadow-lg shrink-0"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Llamar al 928 346 038
        </a>
      </div>

    </div>
  </article>

  <!-- Fullscreen Lightbox Modal (Tamaño Real) -->
  <div
    id="lightbox-modal"
    class="fixed inset-0 z-50 hidden bg-black/95 backdrop-blur-2xl flex items-center justify-center p-4 sm:p-8 transition-opacity duration-300 cursor-zoom-out"
    aria-modal="true"
    role="dialog"
  >
    <!-- Close Button -->
    <button
      id="lightbox-close"
      class="absolute top-6 right-6 z-50 w-12 h-12 rounded-full bg-white/10 hover:bg-brand-red text-white flex items-center justify-center text-2xl font-bold transition-all hover:scale-110 border border-white/20 shadow-2xl"
      aria-label="Cerrar vista a tamaño real"
    >
      ✕
    </button>

    <!-- Fullscreen Real Size Image -->
    <div class="relative max-w-full max-h-full flex items-center justify-center p-2">
      <img
        id="lightbox-img"
        src=""
        alt="Fotografía a tamaño real"
        class="max-w-full max-h-[92vh] w-auto h-auto object-contain rounded-2xl shadow-2xl border border-white/20"
      />
    </div>
  </div>
</Layout>

<script>
  function initCarouselAndLightbox() {
    const container = document.getElementById('news-carousel');
    const lightboxModal = document.getElementById('lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');

    // Lightbox functions
    function openLightbox(url: string) {
      if (lightboxModal && lightboxImg && url) {
        lightboxImg.src = url;
        lightboxModal.classList.remove('hidden');
        lightboxModal.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox() {
      if (lightboxModal) {
        lightboxModal.classList.add('hidden');
        lightboxModal.classList.remove('flex');
        document.body.style.overflow = '';
      }
    }

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxModal?.addEventListener('click', (e) => {
      if (e.target === lightboxModal || e.target === lightboxImg) {
        closeLightbox();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    document.querySelectorAll<HTMLElement>('.open-lightbox').forEach((element) => {
      element.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = e.currentTarget as HTMLElement;
        const imgUrl = target.getAttribute('data-full-img') || (target as HTMLImageElement).src;
        if (imgUrl) {
          openLightbox(imgUrl);
        }
      });
    });

    if (!container) return;

    const slides = container.querySelectorAll<HTMLElement>('.carousel-slide');
    const dots = container.querySelectorAll<HTMLElement>('.carousel-dot');
    const prevBtn = document.getElementById('carousel-prev');
    const nextBtn = document.getElementById('carousel-next');
    const counter = document.getElementById('carousel-counter');
    const thumbBtns = document.querySelectorAll<HTMLElement>('.gallery-thumb');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let autoPlayTimer: any = null;

    function showSlide(index: number) {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, idx) => {
        if (idx === currentIndex) {
          slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
          slide.classList.add('opacity-100', 'z-10', 'pointer-events-auto');
        } else {
          slide.classList.remove('opacity-100', 'z-10', 'pointer-events-auto');
          slide.classList.add('opacity-0', 'z-0', 'pointer-events-none');
        }
      });

      dots.forEach((dot, idx) => {
        if (idx === currentIndex) {
          dot.classList.add('bg-brand-red', 'w-8');
          dot.classList.remove('bg-white/60', 'w-3');
        } else {
          dot.classList.remove('bg-brand-red', 'w-8');
          dot.classList.add('bg-white/60', 'w-3');
        }
      });

      thumbBtns.forEach((thumb, idx) => {
        if (idx === currentIndex) {
          thumb.classList.add('ring-4', 'ring-brand-red', 'scale-105');
        } else {
          thumb.classList.remove('ring-4', 'ring-brand-red', 'scale-105');
        }
      });

      if (counter) {
        counter.textContent = `${currentIndex + 1} / ${slides.length}`;
      }
    }

    function startAutoPlay() {
      stopAutoPlay();
      autoPlayTimer = setInterval(() => {
        showSlide(currentIndex + 1);
      }, 3800);
    }

    function stopAutoPlay() {
      if (autoPlayTimer) {
        clearInterval(autoPlayTimer);
        autoPlayTimer = null;
      }
    }

    prevBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showSlide(currentIndex - 1);
      startAutoPlay();
    });

    nextBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      showSlide(currentIndex + 1);
      startAutoPlay();
    });

    dots.forEach((dot) => {
      dot.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(dot.getAttribute('data-dot-index') || '0', 10);
        showSlide(idx);
        startAutoPlay();
      });
    });

    // Pause on hover
    container.addEventListener('mouseenter', stopAutoPlay);
    container.addEventListener('mouseleave', startAutoPlay);

    // Touch support for mobile devices
    let touchStartX = 0;
    let touchEndX = 0;

    container.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX;
    }, { passive: true });

    container.addEventListener('touchend', (e) => {
      touchEndX = e.changedTouches[0].screenX;
      if (touchStartX - touchEndX > 40) {
        showSlide(currentIndex + 1);
        startAutoPlay();
      } else if (touchEndX - touchStartX > 40) {
        showSlide(currentIndex - 1);
        startAutoPlay();
      }
    }, { passive: true });

    startAutoPlay();
  }

  document.addEventListener('DOMContentLoaded', initCarouselAndLightbox);
  document.addEventListener('astro:page-load', initCarouselAndLightbox);
</script>
