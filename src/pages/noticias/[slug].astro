---
import Layout from '../../layouts/Layout.astro';
import { noticias, formatCategoria } from '../../data/noticias';

export function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const paragrafos = noticia.contenido.split('\n\n');
---

<Layout
  title={`${noticia.titulo} | C.D. Nadamás Las Marinas`}
  description={noticia.resumen}
>
  <!-- Article Header & Body -->
  <article class="pt-28 pb-20 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back button -->
      <div class="mb-8">
        <a
          href="/noticias"
          class="inline-flex items-center gap-2 text-[#ED1C24] hover:underline font-bold text-sm transition-colors group"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Volver a Noticias
        </a>
      </div>

      <!-- Meta badges -->
      <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
        <span class="px-3 py-1 rounded-full bg-[#ED1C24]/10 text-[#ED1C24] font-bold uppercase tracking-wider border border-[#ED1C24]/30">
          {formatCategoria(noticia.categoria)}
        </span>
        <span class="text-slate-400">•</span>
        <span class="text-slate-500 font-medium">{noticia.fecha}</span>
        <span class="text-slate-400">•</span>
        <span class="text-slate-500 font-medium">C.D.N. Nadamás Las Marinas</span>
      </div>

      <!-- Article Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-[#00226D] leading-tight mb-6 font-heading">
        {noticia.titulo}
      </h1>

      <!-- Subtitle / Summary -->
      <p class="text-lg sm:text-xl text-slate-600 leading-relaxed mb-8 font-medium">
        {noticia.resumen}
      </p>

      <!-- Featured Main Image -->
      <div class="relative h-64 sm:h-96 md:h-[480px] rounded-3xl overflow-hidden border border-slate-200 shadow-xl mb-12">
        <img
          src={noticia.imagenPrincipal}
          alt={noticia.titulo}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#00123D]/80 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-6 right-6 flex justify-between items-center text-xs text-white font-medium">
          <span>C.D. Nadamás Las Marinas · C.D. Santa Rosa</span>
          <span class="hidden sm:inline">Costa Teguise, Lanzarote</span>
        </div>
      </div>

      <!-- Article Body Paragraphs -->
      <div class="space-y-6 text-slate-700 text-base md:text-lg leading-relaxed font-normal mb-12">
        {paragrafos.map((para, idx) => (
          <p class={idx === 0 ? "text-[#00226D] font-semibold text-lg md:text-xl leading-relaxed border-l-4 border-[#ED1C24] pl-4 py-2 bg-slate-50 rounded-r-xl" : "text-slate-700 leading-relaxed"}>
            {para}
          </p>
        ))}
      </div>

      <!-- Article Image Gallery (Multiple Images Support) -->
      {noticia.imagenes && noticia.imagenes.length > 0 && (
        <div class="my-12 pt-8 border-t border-slate-200">
          <div class="flex items-center gap-3 mb-6">
            <span class="text-2xl">📸</span>
            <h3 class="text-xl font-bold text-[#00226D] font-heading">Galería Fotográfica de la Noticia</h3>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {noticia.imagenes.map((imgUrl, imgIdx) => (
              <div class="relative h-48 rounded-2xl overflow-hidden border border-slate-200 shadow-md group">
                <img
                  src={imgUrl}
                  alt={`Imagen ${imgIdx + 1} de ${noticia.titulo}`}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Share & CTA Footer Box -->
      <div class="mt-12 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-6 card-modern p-6 bg-slate-50">
        <div>
          <h4 class="text-[#00226D] font-bold text-base mb-1 font-heading">¿Quieres entrenar con nosotros?</h4>
          <p class="text-slate-600 text-xs">Consulta cuotas y prueba de nivel llamando al 928 346 038 (L a V 16:00-19:30 h).</p>
        </div>
        <a
          href="tel:928346038"
          class="btn-cta-primary inline-flex items-center gap-2 px-6 py-3 text-sm shadow-lg shrink-0"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
          </svg>
          Llamar al 928 346 038
        </a>
      </div>

    </div>
  </article>
</Layout>
