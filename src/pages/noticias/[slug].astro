---
import Layout from '../../layouts/Layout.astro';
import { noticias } from '../../data/noticias';

export function getStaticPaths() {
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
---

<Layout
  title={`${noticia.titulo} | C.D. Nadamás Las Marinas`}
  description={noticia.resumen}
>
  <!-- Article Header -->
  <article class="pt-28 pb-20 bg-ocean-950 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Back button -->
      <div class="mb-8">
        <a
          href="/noticias"
          class="inline-flex items-center gap-2 text-cyan-400 hover:text-cyan-300 font-semibold text-sm transition-colors group"
        >
          <svg class="w-4 h-4 group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          Volver a Noticias
        </a>
      </div>

      <!-- Meta badges -->
      <div class="flex flex-wrap items-center gap-3 text-xs mb-4">
        <span class="px-3 py-1 rounded-full bg-cyan-400/15 border border-cyan-400/30 text-cyan-400 font-bold uppercase tracking-wider">
          {noticia.categoria}
        </span>
        <span class="text-white/40">•</span>
        <span class="text-white/60">{noticia.fecha}</span>
        <span class="text-white/40">•</span>
        <span class="text-white/60">Por {noticia.autor}</span>
        <span class="text-white/40">•</span>
        <span class="text-white/60">Lectura: {noticia.tiempoLectura}</span>
      </div>

      <!-- Article Title -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-black text-white leading-tight mb-6">
        {noticia.titulo}
      </h1>

      <!-- Subtitle / Summary -->
      <p class="text-lg sm:text-xl text-white/80 leading-relaxed mb-8 font-medium">
        {noticia.resumen}
      </p>

      <!-- Featured Image -->
      <div class="relative h-64 sm:h-96 md:h-[450px] rounded-3xl overflow-hidden border border-white/10 shadow-2xl mb-12">
        <img
          src={noticia.imagen}
          alt={noticia.titulo}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-ocean-950/80 via-transparent to-transparent"></div>
        <div class="absolute bottom-4 left-6 right-6 flex justify-between items-center text-xs text-white/70">
          <span>C.D. Nadamás Las Marinas · C.D. Santa Rosa</span>
          <span class="hidden sm:inline">Costa Teguise, Lanzarote</span>
        </div>
      </div>

      <!-- Article Body -->
      <div class="space-y-6 text-white/80 text-base md:text-lg leading-relaxed font-normal">
        <p class="text-white font-medium text-lg md:text-xl leading-relaxed border-l-4 border-cyan-400 pl-4 py-1 bg-white/5 rounded-r-xl">
          {noticia.contenido.introduccion}
        </p>

        {noticia.contenido.parrafos.map((p) => (
          <p class="text-white/80">{p}</p>
        ))}

        <!-- Results Table (if present) -->
        {noticia.contenido.destacadosResultados && noticia.contenido.destacadosResultados.length > 0 && (
          <div class="my-8 glass-card p-6 md:p-8 border border-gold-400/30 rounded-2xl">
            <div class="flex items-center gap-3 mb-6">
              <span class="text-3xl">🏆</span>
              <h3 class="text-xl font-bold text-white">Resultados Destacados</h3>
            </div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="border-b border-white/10 text-cyan-400 text-xs uppercase tracking-wider">
                    <th class="py-3 px-4">Deportista / Relevo</th>
                    <th class="py-3 px-4">Prueba / Categoría</th>
                    <th class="py-3 px-4">Resultado</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-white/5 text-sm">
                  {noticia.contenido.destacadosResultados.map((res) => (
                    <tr class="hover:bg-white/5 transition-colors">
                      <td class="py-3.5 px-4 font-bold text-white">{res.atleta}</td>
                      <td class="py-3.5 px-4 text-white/70">{res.prueba}</td>
                      <td class="py-3.5 px-4 font-bold text-gold-400">{res.puesto}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}

        <p class="text-white/90 font-medium">
          {noticia.contenido.conclusion}
        </p>
      </div>

      <!-- Share & CTA Footer Box -->
      <div class="mt-12 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-6">
        <div>
          <h4 class="text-white font-bold text-base mb-1">¿Quieres entrenar con nosotros?</h4>
          <p class="text-white/60 text-xs">Pide tu clase de prueba gratuita en la piscina del C.D. Santa Rosa.</p>
        </div>
        <a
          href="https://wa.me/34600000000?text=Hola%2C%20he%20le%C3%ADdo%20la%20noticia%20sobre%20el%20club%20y%20quiero%20informaci%C3%B3n"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-6 py-3 bg-gradient-to-r from-green-500 to-green-600 hover:from-green-600 hover:to-green-700 text-white text-sm font-bold rounded-full shadow-lg hover:scale-105 transition-all shrink-0"
        >
          <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          WhatsApp Club
        </a>
      </div>

    </div>
  </article>
</Layout>
